APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###########################################################################
# Mavkora — datos de la empresa
###########################################################################
# Se usan en la web, en el chatbot y en el panel. Reemplaza los de ejemplo.
MAVKORA_EMAIL=info@mavkora.com
MAVKORA_PHONE="+57 300 123 4567"
# Número de WhatsApp en formato internacional, sin '+' ni espacios.
MAVKORA_WHATSAPP=573001234567

###########################################################################
# Chatbot de WhatsApp
###########################################################################
# Clave compartida con n8n. Genérala con: php artisan mavkora:bot-key
BOT_API_KEY=

# La IA se cobra por consulta (~1 centavo de dólar cada una).
# En false el bot responde igual: usa la base de conocimiento local, que es
# gratuita y cubre precios, tiempos, horarios, proceso, tecnologías y soporte.
# Ponla en true solo cuando tengas saldo en console.anthropic.com
BOT_AI_ENABLED=false

# Horas de silencio antes de que una conversación a medias vuelva al saludo.
BOT_SESSION_TIMEOUT_HOURS=12

# A dónde avisar cuando alguien pide hablar con una persona.
BOT_HANDOFF_EMAIL=

# Cuánto calla el bot después de escalar a un asesor.
BOT_HANDOFF_SILENCE_HOURS=24

###########################################################################
# WhatsApp Cloud API (Meta)
###########################################################################
# Se configuran en developers.facebook.com. Ver docs/CHATBOT-WHATSAPP.md
# El token de acceso NO va aquí: vive en las credenciales de n8n.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

###########################################################################
# n8n
###########################################################################
N8N_HOST=localhost
N8N_PROTOCOL=http
# URL pública del túnel o dominio. Meta exige HTTPS.
N8N_WEBHOOK_URL=http://localhost:5678/
# Cámbiala antes del primer arranque: si la cambias después, n8n pierde
# el acceso a las credenciales ya guardadas.
N8N_ENCRYPTION_KEY=
